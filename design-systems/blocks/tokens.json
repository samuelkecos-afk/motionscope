{
  "color": {
    "black": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Page background, dark blocks"
    },
    "white": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "blue": {
      "$type": "color",
      "$value": "#190bb6",
      "$description": "Tiles section, footer"
    },
    "yellow": {
      "$type": "color",
      "$value": "#f7dd47",
      "$description": "Intro block (black text)"
    },
    "orange": {
      "$type": "color",
      "$value": "#e74a27",
      "$description": "Statement block"
    },
    "line-light": {
      "$type": "color",
      "$value": "#ffffff1a"
    },
    "line-dark": {
      "$type": "color",
      "$value": "#0000001a"
    },
    "tint-light": {
      "$type": "color",
      "$value": "#ffffff99"
    },
    "tint-dark": {
      "$type": "color",
      "$value": "#00000099"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Geist",
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ],
      "$description": "Stand-in for Suisse Int'l"
    },
    "weight": {
      "default": {
        "$type": "fontWeight",
        "$value": 600
      },
      "body": {
        "$type": "fontWeight",
        "$value": 500
      }
    }
  },
  "typography": {
    "hero": {
      "$type": "typography",
      "$description": "Hero headline, footer wordmark. Fluid: 64px (phone) \u2192 164px (\u2265768) \u2192 320px (\u22651280); size = max(base*0.8 + 100vw*base/W*0.2, base), W = 375/768/1280/1600.",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.weight.default}",
        "fontSize": "320px",
        "lineHeight": 0.85,
        "letterSpacing": "-0.045em",
        "textTransform": "uppercase"
      }
    },
    "display": {
      "$type": "typography",
      "$description": "Section names, ticker, tile words. Fluid: 48px (phone) \u2192 48px (\u2265768) \u2192 132px (\u22651280); size = max(base*0.8 + 100vw*base/W*0.2, base), W = 375/768/1280/1600.",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.weight.default}",
        "fontSize": "132px",
        "lineHeight": 0.91,
        "letterSpacing": "-0.045em",
        "textTransform": "uppercase"
      }
    },
    "title": {
      "$type": "typography",
      "$description": "Statements, closing titles. Fluid: 32px (phone) \u2192 64px (\u2265768) \u2192 96px (\u22651280); size = max(base*0.8 + 100vw*base/W*0.2, base), W = 375/768/1280/1600.",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.weight.default}",
        "fontSize": "96px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.027em",
        "textTransform": "none"
      }
    },
    "name": {
      "$type": "typography",
      "$description": "Lists, FAQ questions, prices. Fluid: 24px (phone) \u2192 24px (\u2265768) \u2192 46px (\u22651280); size = max(base*0.8 + 100vw*base/W*0.2, base), W = 375/768/1280/1600.",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.weight.default}",
        "fontSize": "46px",
        "lineHeight": 1.04,
        "letterSpacing": "-0.027em",
        "textTransform": "none"
      }
    },
    "lede": {
      "$type": "typography",
      "$description": "Intro paragraph. Fluid: 21px (phone) \u2192 21px (\u2265768) \u2192 32px (\u22651280); size = max(base*0.8 + 100vw*base/W*0.2, base), W = 375/768/1280/1600.",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.weight.default}",
        "fontSize": "32px",
        "lineHeight": 1.11,
        "letterSpacing": "-0.027em",
        "textTransform": "none"
      }
    },
    "body": {
      "$type": "typography",
      "$description": "Details and answers. Fluid: 14px (phone) \u2192 14px (\u2265768) \u2192 16px (\u22651280); size = max(base*0.8 + 100vw*base/W*0.2, base), W = 375/768/1280/1600.",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.weight.body}",
        "fontSize": "16px",
        "lineHeight": 1.22,
        "letterSpacing": "-0.027em",
        "textTransform": "none"
      }
    },
    "label": {
      "$type": "typography",
      "$description": "Labels, nav, buttons, links. Fluid: 12px (phone) \u2192 12px (\u2265768) \u2192 16px (\u22651280); size = max(base*0.8 + 100vw*base/W*0.2, base), W = 375/768/1280/1600.",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": "{font.weight.default}",
        "fontSize": "16px",
        "lineHeight": 1.0,
        "letterSpacing": "0em",
        "textTransform": "uppercase"
      }
    }
  },
  "space": {
    "gutter": {
      "$type": "dimension",
      "$value": "16px"
    },
    "gap-phone": {
      "$type": "dimension",
      "$value": "10px"
    },
    "gap": {
      "$type": "dimension",
      "$value": "16px"
    },
    "section-end": {
      "$type": "dimension",
      "$value": "180px",
      "$description": "70 \u2192 120 \u2192 180px, fluid"
    },
    "label-to-headline": {
      "$type": "dimension",
      "$value": "170px",
      "$description": "75 \u2192 120 \u2192 170px, fluid"
    },
    "closing-link": {
      "$type": "dimension",
      "$value": "160px",
      "$description": "70 \u2192 100 \u2192 160px, fluid"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.26,
        1,
        0.48,
        1
      ]
    },
    "duration": {
      "$type": "duration",
      "$value": "500ms"
    },
    "duration-fade": {
      "$type": "duration",
      "$value": "75ms"
    },
    "intro-delay": {
      "$type": "duration",
      "$value": "750ms"
    }
  },
  "grid": {
    "columns": {
      "$type": "number",
      "$value": 24,
      "$description": "8 phone \u00b7 16 tablet \u00b7 24 desktop"
    }
  }
}