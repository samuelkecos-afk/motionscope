{
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#000000"
    },
    "fg": {
      "$type": "color",
      "$value": "#f2f2f2"
    },
    "muted-fg": {
      "$type": "color",
      "$value": "#aeaeae"
    },
    "primary": {
      "$type": "color",
      "$value": "#00ece7",
      "$description": "Neon cyan: buttons, dates, eyebrows"
    },
    "primary-fg": {
      "$type": "color",
      "$value": "#020202"
    },
    "gradient-start": {
      "$type": "color",
      "$value": "#8ffaf6"
    },
    "gradient-mid": {
      "$type": "color",
      "$value": "#00ece7"
    },
    "gradient-end": {
      "$type": "color",
      "$value": "#00d1d9"
    },
    "card-bg": {
      "$type": "color",
      "$value": "#002120",
      "$description": "Show cards"
    },
    "card-border": {
      "$type": "color",
      "$value": "#00e0d180",
      "$description": "3px, 80% on hover"
    },
    "yellow": {
      "$type": "color",
      "$value": "#ffd700",
      "$description": "Announcement strip"
    },
    "border": {
      "$type": "color",
      "$value": "#ffffff4d"
    },
    "danger": {
      "$type": "color",
      "$value": "#f94144"
    },
    "success": {
      "$type": "color",
      "$value": "#5edb81"
    },
    "warning": {
      "$type": "color",
      "$value": "#fabb41"
    },
    "info": {
      "$type": "color",
      "$value": "#70adfb"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Anton",
        "Impact",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "typography": {
    "hero": {
      "$type": "typography",
      "$description": "48 \u2192 60 (\u2265640) \u2192 72 (\u2265768) \u2192 96 (\u22651024) \u2192 128px (\u22651280)",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "128px",
        "lineHeight": 0.9,
        "fontWeight": 400,
        "letterSpacing": "-0.025em",
        "textTransform": "uppercase"
      }
    },
    "section": {
      "$type": "typography",
      "$description": "30 \u2192 36 \u2192 48 \u2192 60px",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "60px",
        "lineHeight": 1.0,
        "fontWeight": 400,
        "letterSpacing": "-0.025em",
        "textTransform": "uppercase"
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$description": "12 \u2192 14px, cyan",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "14px",
        "lineHeight": 1.43,
        "fontWeight": 600,
        "letterSpacing": "0.3em",
        "textTransform": "uppercase"
      }
    },
    "subtitle": {
      "$type": "typography",
      "$description": "14 \u2192 16px, grey",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "16px",
        "lineHeight": 1.5,
        "fontWeight": 400,
        "letterSpacing": "0",
        "textTransform": "none"
      }
    },
    "card-title": {
      "$type": "typography",
      "$description": "20 \u2192 24px",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "24px",
        "lineHeight": 1.25,
        "fontWeight": 700,
        "letterSpacing": "0",
        "textTransform": "none"
      }
    },
    "card-meta": {
      "$type": "typography",
      "$description": "16 \u2192 18px, cyan",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "18px",
        "lineHeight": 1.5,
        "fontWeight": 700,
        "letterSpacing": "0",
        "textTransform": "none"
      }
    },
    "step": {
      "$type": "typography",
      "$description": "",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "18px",
        "lineHeight": 1.4,
        "fontWeight": 700,
        "letterSpacing": "-0.025em",
        "textTransform": "none"
      }
    },
    "body": {
      "$type": "typography",
      "$description": "",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "16px",
        "lineHeight": "28px",
        "fontWeight": 400,
        "letterSpacing": "0",
        "textTransform": "none"
      }
    },
    "button": {
      "$type": "typography",
      "$description": "",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 700,
        "letterSpacing": "0.05em",
        "textTransform": "uppercase"
      }
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "16px"
    },
    "panel": {
      "$type": "dimension",
      "$value": "12px"
    },
    "input": {
      "$type": "dimension",
      "$value": "10px"
    },
    "button": {
      "$type": "dimension",
      "$value": "6px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "space": {
    "container": {
      "$type": "dimension",
      "$value": "1280px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "16 \u2192 24 \u2192 32px"
    },
    "section": {
      "$type": "dimension",
      "$value": "80px",
      "$description": "48 \u2192 80px"
    },
    "band": {
      "$type": "dimension",
      "$value": "96px",
      "$description": "64 \u2192 96px"
    },
    "grid-gap": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 4px 20px #0006, 0 0 12px #00e0d11f"
    },
    "card-hover": {
      "$type": "shadow",
      "$value": "0 8px 40px #0009, 0 0 24px #00e0d140"
    },
    "glow-button": {
      "$type": "shadow",
      "$value": "0 0 15px #00ece74d, 0 0 40px #00ece71a"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "ease-card": {
      "$type": "cubicBezier",
      "$value": [
        0.25,
        0.46,
        0.45,
        0.94
      ]
    },
    "duration-fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "duration-card": {
      "$type": "duration",
      "$value": "500ms"
    },
    "duration-image": {
      "$type": "duration",
      "$value": "700ms"
    }
  }
