{
  "name": "motionscope",
  "description": "Inspect a website's animations, scroll motion and design system.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "npm run setup:fixture && wxt build && node test/e2e.mjs && node test/patterns.mjs && node test/perf.mjs",
    "setup:fixture": "mkdir -p test/fixture/vendor && cp node_modules/gsap/dist/gsap.min.js node_modules/gsap/dist/ScrollTrigger.min.js test/fixture/vendor/",
    "test:perf": "wxt build && node test/perf.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "gsap": "^3.15.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
